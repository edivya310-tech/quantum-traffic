APP_NAME=Quantum Traffic Optimization
APP_ENV=development
DATABASE_URL=sqlite:///./traffic.db
SIMULATION_STEP_SECONDS=1
METRICS_SAMPLE_INTERVAL=5
OPTIMIZATION_INTERVAL=30
MIN_GREEN=10
MAX_GREEN=60
YELLOW_TIME=3
ALL_RED_TIME=1
QAOA_SHOTS=1024
QAOA_REPS=1
RANDOM_SEED=42
TRAFFIC_ENGINE=custom
ENABLE_QUANTUM=true
